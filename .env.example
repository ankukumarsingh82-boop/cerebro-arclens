# ArcLens runs fully offline. No API keys are required.
# Copy to .env only if you want to override defaults.

ARCLENS_HOST=127.0.0.1
ARCLENS_PORT=8000

# Cap how many turns a single upload may expand into.
ARCLENS_MAX_TURNS=2000

# Leave at 0. The MVP is local-first (VADER + interpretable heuristics).
# Set to 1 only if you have installed optional transformers extras yourself.
ARCLENS_USE_TRANSFORMERS=0
